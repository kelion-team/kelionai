#!/bin/bash
# PROCEDURA COMPLETĂ DE DEPLOY — UN SINGUR CUVÂNT (ordinul lui Adrian, 11 iul:
# „el dă deploy dar nu știe ce e în spatele comenzii — faci o procedură cu tot
# ce trebuie, o legi de deploy și când dă deploy se apelează, cu tot cu cheie,
# fără să mă streseze pe mine").
#
# Kelion scrie `deploy` și AICI se întâmplă TOT, automat, fără nicio parolă:
#   1. CHEIA: tokenul GitHub e deja instalat pe VPS
#      (/root/kelion/github-token.txt, pus o singură dată prin vps-keys) —
#      nu se cere nimic, nimănui, niciodată;
#   2. se citește versiunea live (https://kelionai.app/api/version) ÎNAINTE;
#   3. se pornește pipeline-ul OFICIAL: dispatch .github/workflows/deploy.yml
#      pe master → Railway construiește și publică EXACT origin/master;
#   4. verificarea ANTI-FANTOMĂ: se așteaptă (max ~8 min) până versiunea live
#      CHIAR se schimbă; dacă nu se schimbă → „deploy EȘUAT", spus cinstit —
#      NICIODATĂ declarat succes fără dovadă.
#
# REGULILE DE FIER rămân: NICIODATĂ `railway up` direct; NICIODATĂ GitHub prin
# browser (repo privat → 404 + zid de login); publicat = DOAR origin/master.
exec "$(dirname "$(readlink -f "$0")")/kelion-github" deploy "$@"
