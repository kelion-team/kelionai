#!/bin/bash
# MÂINILE GITHUB ALE LUI KELION (ordinul lui Adrian, 11 iul: „identic ca tine").
# Aceleași operațiuni pe care le face Claude: PR, merge, deploy VERIFICAT,
# citirea rulărilor. Token: /root/kelion/github-token.txt (pus prin vps-keys,
# token fin-granulat DOAR pe repo-ul kelion-team/kelionai).
#
#   kelion-github pr <branch> "titlu" ["descriere"]   → deschide PR spre master
#   kelion-github merge <numar-pr>                    → squash-merge
#   kelion-github publish <branch> "titlu" ["desc"]   → PUBLICARE COMPLETĂ cap-coadă
#   kelion-github deploy                              → deploy.yml + verificare anti-fantomă
#   kelion-github rollback                            → revino la starea de dinaintea ultimului commit master + deploy
#   kelion-github doctor                              → DIAGNOZĂ cheie: formă + drepturi reale (PR/Contents/Actions)
#   kelion-github runs [workflow.yml]                 → ultimele rulări (stare+concluzie)
#   kelion-github api <cale>                          → ORICE citire GitHub, cu tokenul
#
# PUBLICARE COMPLETĂ AUTONOMĂ (Adrian, 12 iul: „Kelion trebuie să ducă o reparație
# completă"): `publish` duce un branch în producție SINGUR, fără să se blocheze pe
# limitările tokenului. Încearcă întâi PR + squash-merge (păstrează audit-trail-ul);
# dacă tokenul fin-granulat NU poate deschide PR (403 „Resource not accessible" —
# blocajul real observat pe 11 iul), cade automat pe `POST /merges` (merge
# branch→master direct pe GitHub, cu `contents:write` pe care tokenul îl are sigur,
# de vreme ce poate face push). Apoi rulează `deploy` (dispatch + verificarea
# anti-fantomă: versiunea live TREBUIE să se schimbe). Aprobarea umană a lui Adrian
# în Admin → Release-uri E deja gardul; `publish` doar execută ce a fost aprobat.
#
# NICIODATĂ GitHub prin BROWSER (lecția din 11 iul: repo-ul e PRIVAT — browserul
# anonim primește 404 + zid de „Sign in" și te blochezi acolo). Orice pagină
# GitHub ai vrea să „vezi", citește-o cu `api`: ex. `kelion-github api /pulls/106`,
# `api /commits/master`, `api "/actions/runs?per_page=3"`. Trece direct, cu cheia.
#
# REGULA DE FIER rămâne: NICIODATĂ railway up direct — doar `deploy` de aici,
# care trece prin pipeline-ul cu verificarea că versiunea live CHIAR s-a schimbat.
set -u
REPO="kelion-team/kelionai"
API="https://api.github.com/repos/$REPO"
TOKEN=$(cat /root/kelion/github-token.txt 2>/dev/null || true)
[ -z "$TOKEN" ] && { echo "EROARE: lipsește /root/kelion/github-token.txt (Adrian îl pune prin vps-keys)"; exit 1; }
gh_api() { curl -sS --max-time 30 -H "Authorization: Bearer $TOKEN" -H "Accept: application/vnd.github+json" "$@"; }

# VERIFICARE TOKEN (Adrian, 14 iul): refuzăm operațiunile imediat dacă tokenul e
# invalid/expirat, ca să nu apară încercări de merge/deploy cu 401 în jurnal.
check_token() {
  local code body
  code=$(gh_api -o /tmp/gh_token_check.json -w '%{http_code}' "https://api.github.com/user")
  if [ "$code" != "200" ]; then
    body=$(jq -r '.message // "token invalid"' /tmp/gh_token_check.json 2>/dev/null || echo "token invalid")
    echo "EROARE: tokenul GitHub e invalid (HTTP $code: $body). Oprește tot și înlocuiește /root/kelion/github-token.txt." >&2
    exit 1
  fi
}
check_token

cmd=${1:-}; shift || true
case "$cmd" in
  pr)
    branch=${1:?branch}; title=${2:?titlu}; body=${3:-}
    gh_api -X POST "$API/pulls" -d "$(jq -nc --arg h "$branch" --arg t "$title" --arg b "$body" \
      '{title:$t, head:$h, base:"master", body:$b}')" | jq -r '.number // .message | "PR: \(.)"'
    ;;
  merge)
    n=${1:?numar PR}
    gh_api -X PUT "$API/pulls/$n/merge" -d '{"merge_method":"squash"}' | jq -r '.merged // .message | "merge: \(.)"'
    ;;
  publish)
    # PUBLICARE COMPLETĂ cap-coadă, fără dependență de dreptul de a deschide PR.
    branch=${1:?branch}; title=${2:?titlu}; body=${3:-}
    echo "▶ Publicare completă pentru branch: $branch"
    merged=""
    # 1) Preferat: PR + squash-merge (păstrează audit-trail-ul), DACĂ tokenul poate.
    pr_code=$(gh_api -o /tmp/kg_pr.json -w '%{http_code}' -X POST "$API/pulls" -d "$(jq -nc --arg h "$branch" --arg t "$title" --arg b "$body" \
      '{title:$t, head:$h, base:"master", body:$b}')")
    pr_num=$(jq -r '.number // empty' /tmp/kg_pr.json 2>/dev/null)
    if [ -n "$pr_num" ]; then
      echo "  PR #$pr_num deschis — squash-merge"
      m_resp=$(gh_api -X PUT "$API/pulls/$pr_num/merge" -d '{"merge_method":"squash"}')
      if [ "$(echo "$m_resp" | jq -r '.merged // false')" = "true" ]; then
        merged="PR #$pr_num"
      else
        echo "  ⚠️ merge PR eșuat: $(echo "$m_resp" | jq -r '.message // "necunoscut"')"
      fi
    else
      pr_msg=$(jq -r '.message // "necunoscut"' /tmp/kg_pr.json 2>/dev/null)
      if [ "$pr_code" = "403" ]; then
        echo "  🔑 CHEIE GITHUB fără drept de PR: tokenul fin-granulat NU are 'Pull requests: write' (HTTP 403: $pr_msg). PR-urile NU se pot deschide cu cheia asta — cad pe merge direct branch→master. Ca să se deschidă PR-uri, dă tokenului scope-ul 'Pull requests: Read and write' prin vps-keys."
      elif [ "$pr_code" = "401" ]; then
        echo "  🔑 CHEIE GITHUB INVALIDĂ/EXPIRATĂ (HTTP 401 la deschiderea PR: $pr_msg). Reînnoiește tokenul prin vps-keys — /root/kelion/github-token.txt."
      else
        echo "  ℹ️ PR indisponibil (HTTP $pr_code: $pr_msg) — cad pe merge direct branch→master"
      fi
    fi
    # 2) Fallback robust: merge direct branch→master pe GitHub (doar contents:write,
    #    pe care tokenul îl are — de vreme ce poate face push). Ocolește 403-ul de PR.
    if [ -z "$merged" ]; then
      code=$(gh_api -o /tmp/kg_merge.json -w '%{http_code}' -X POST "$API/merges" -d "$(jq -nc \
        --arg base "master" --arg head "$branch" --arg msg "builder: $title" \
        '{base:$base, head:$head, commit_message:$msg}')")
      case "$code" in
        201) merged="merge direct (commit nou pe master)" ;;
        204) merged="master deja la zi (nimic de făcut)" ;;
        409) echo "  ❌ CONFLICT branch→master — publicare oprită (necesită rezolvare manuală)"; exit 1 ;;
        401|403)
          # Cheia nu poate NICI măcar merge direct → e expirată/revocată/sub-scopată.
          # Fără asta NIMIC nu se publică — de-aici blocajul „din cauza unei chei".
          echo "  🔑 CHEIE GITHUB INEFICIENTĂ (HTTP $code la merge direct: $(jq -r '.message // empty' /tmp/kg_merge.json 2>/dev/null)). Tokenul nu are nici 'Contents: write' valid → NIMIC nu se poate publica. Reînnoiește/re-scopează tokenul prin vps-keys (/root/kelion/github-token.txt)."; exit 1 ;;
        *)   echo "  ❌ merge branch→master eșuat → HTTP $code: $(jq -r '.message // empty' /tmp/kg_merge.json 2>/dev/null)"; exit 1 ;;
      esac
    fi
    echo "  ✅ master actualizat prin: $merged — pornesc deploy verificat"
    # 3) Deploy cu verificarea anti-fantomă (aceeași cale ca `deploy`).
    exec "$0" deploy
    ;;
  deploy)
    BEFORE=$(curl -s --max-time 8 https://kelionai.app/api/version || echo '{}')
    echo "versiune înainte: $BEFORE"
    CODE=$(gh_api -o /dev/null -w '%{http_code}' -X POST "$API/actions/workflows/deploy.yml/dispatches" -d '{"ref":"master"}')
    [ "$CODE" != "204" ] && { echo "EROARE: dispatch deploy.yml → HTTP $CODE"; exit 1; }
    echo "deploy.yml pornit — aștept verificarea anti-fantomă (versiunea TREBUIE să se schimbe)…"
    for i in $(seq 1 60); do
      sleep 8
      NOW=$(curl -s --max-time 8 https://kelionai.app/api/version || echo '{}')
      if [ -n "$NOW" ] && [ "$NOW" != "$BEFORE" ] && [ "$NOW" != "{}" ]; then
        echo "✅ PUBLICAT + VERIFICAT: $NOW"
        exit 0
      fi
    done
    echo "❌ Versiunea NU s-a schimbat în ~8 min — deploy eșuat sau fantomă. NU declara succes."
    exit 1
    ;;
  runs)
    wf=${1:-}
    if [ -n "$wf" ]; then url="$API/actions/workflows/$wf/runs?per_page=5"; else url="$API/actions/runs?per_page=5"; fi
    gh_api "$url" | jq -r '.workflow_runs[] | "\(.created_at)  \(.name)  \(.status)/\(.conclusion // "-")  \(.html_url)"'
    ;;
  rollback)
    # ROLLBACK RAPID (Adrian, 14 iul: „revino la ultimul master bun + redeploy")
    # dacă un deploy strică producția. PUR prin API — FĂRĂ git local, FĂRĂ
    # force-push, FĂRĂ pierdere de istoric: creează un commit NOU al cărui arbore
    # e starea de dinaintea ultimului commit de pe master (revert curat), mută
    # master pe el (fast-forward), apoi deploy verificat anti-fantomă.
    CTJ="-H Content-Type:application/json"
    HEAD=$(gh_api "$API/commits/master" | jq -r '.sha // empty')
    [ -z "$HEAD" ] && { echo "❌ nu pot citi master (verifică cheia: kelion-github doctor)"; exit 1; }
    PARENT=$(gh_api "$API/commits/$HEAD" | jq -r '.parents[0].sha // empty')
    [ -z "$PARENT" ] && { echo "❌ master ($HEAD) nu are părinte — nu pot face rollback"; exit 1; }
    PTREE=$(gh_api "$API/git/commits/$PARENT" | jq -r '.tree.sha // empty')
    [ -z "$PTREE" ] && { echo "❌ nu găsesc arborele părintelui $PARENT"; exit 1; }
    echo "▶ Rollback: master $HEAD → revin la starea din $PARENT"
    NEW=$(gh_api $CTJ -X POST "$API/git/commits" -d "$(jq -nc \
      --arg m "rollback: revin la $PARENT (anulez $HEAD)" --arg t "$PTREE" --arg p "$HEAD" \
      '{message:$m, tree:$t, parents:[$p]}')" | jq -r '.sha // empty')
    [ -z "$NEW" ] && { echo "❌ nu am putut crea commit-ul de rollback (verifică Contents:write cu doctor)"; exit 1; }
    code=$(gh_api $CTJ -o /tmp/kg_rb.json -w '%{http_code}' -X PATCH "$API/git/refs/heads/master" \
      -d "$(jq -nc --arg s "$NEW" '{sha:$s, force:false}')")
    [ "$code" != 200 ] && { echo "❌ nu am putut muta master pe rollback → HTTP $code: $(jq -r '.message // empty' /tmp/kg_rb.json 2>/dev/null)"; exit 1; }
    echo "  ✅ master mutat pe $NEW (starea din $PARENT) — pornesc deploy verificat"
    exec "$0" deploy
    ;;
  doctor)
    # DIAGNOZĂ CHEIE GitHub — pentru Kelion (Adrian, 14 iul: „verificator cu
    # diagnoză și lui Kelion să poată folosi" + „să le facă automat sau să-mi dea
    # suport să fac eu"). Prinde DIN TIMP o cheie stricată/sub-scopată — ÎNAINTE
    # de o publicare, nu în mijlocul unei bucle. NU expune valoarea cheii. NU
    # declanșează niciun deploy real (proba de Actions e o CITIRE, nu dispatch).
    #   kelion-github doctor           → raport uman complet
    #   kelion-github doctor --brief   → o linie mașină (KEY_OK / KEY_PROBLEM: <suport>)
    #                                    + exit code = numărul de probleme (0 = sănătos)
    # SUPORT-UL e mesajul gata-formulat pentru Adrian: exact ce butoane să apese
    # (un token NU poate fi generat de Kelion — login+2FA, browserul GitHub e
    # interzis; deci Kelion detectează + ghidează, NU schimbă credențiale singur).
    BRIEF=""; [ "${1:-}" = "--brief" ] && BRIEF=1
    TRIM=$(printf '%s' "$TOKEN" | tr -d '[:space:]')
    PROB=0; SUPORT=""
    addp() { PROB=$((PROB + 1)); SUPORT="${SUPORT}($PROB) $1  "; }

    rc=$(gh_api -o /dev/null -w '%{http_code}' "$API")
    pc=$(gh_api -o /dev/null -w '%{http_code}' -X POST "$API/pulls" -d '{"title":"__doctor__","head":"master","base":"master"}')
    mc=$(gh_api -o /dev/null -w '%{http_code}' -X POST "$API/merges" -d '{"base":"master","head":"master"}')
    ac=$(gh_api -o /dev/null -w '%{http_code}' "$API/actions/workflows/deploy.yml")
    SHAPE_OK=1; printf '%s' "$TRIM" | grep -q '^github_pat_' || SHAPE_OK=0
    [ "${#TOKEN}" != "${#TRIM}" ] && SHAPE_OK=0

    # Evaluare → probleme + suport concret (pașii exacți pentru Adrian).
    if [ "$rc" = 401 ] || [ "$SHAPE_OK" = 0 ]; then
      addp "Cheia GitHub e invalidă/greșită. Generează una NOUĂ (fine-grained) la https://github.com/settings/personal-access-tokens/new — Resource owner: kelion-team, Only select repositories: kelionai, iar la Repository permissions pune Pull requests + Contents + Actions = Read and write. Apoi pune-o în secretul VPS_GITHUB_TOKEN (https://github.com/kelion-team/kelionai/settings/secrets/actions/VPS_GITHUB_TOKEN) și rulează workflow-ul vps-keys cu which=github."
    else
      [ "$pc" = 403 ] && addp "Tokenului îi lipsește «Pull requests: Read and write». Editează-l la https://github.com/settings/personal-access-tokens (nu-l regenera — la editare valoarea rămâne), pune Pull requests = Read and write, Update."
      [ "$mc" = 403 ] && addp "Tokenului îi lipsește «Contents: Read and write». Același link, pune Contents = Read and write, Update."
      { [ "$ac" = 403 ] || [ "$ac" = 404 ]; } && addp "Tokenului îi lipsește «Actions: Read and write». Același link, pune Actions = Read and write, Update."
    fi

    if [ -n "$BRIEF" ]; then
      if [ "$PROB" = 0 ]; then echo "KEY_OK"; else echo "KEY_PROBLEM: $SUPORT"; fi
      exit "$PROB"
    fi

    # Raport uman complet.
    echo "== Forma cheii (nu se afișează valoarea) =="
    echo "  lungime ${#TOKEN} car. (fără spații ${#TRIM}) | github_pat_: $(printf '%s' "$TRIM" | grep -q '^github_pat_' && echo DA || echo NU)"
    echo "== Drepturi reale =="
    echo "  Acces repo (GET):        HTTP $rc  $([ "$rc" = 200 ] && echo ✅ || echo ❌)"
    echo "  Pull requests: write:    HTTP $pc  $([ "$pc" = 422 ] && echo ✅ || echo ❌)"
    echo "  Contents: write:         HTTP $mc  $({ [ "$mc" = 204 ] || [ "$mc" = 409 ] || [ "$mc" = 422 ]; } && echo ✅ || echo ❌)"
    echo "  Actions (citire deploy): HTTP $ac  $([ "$ac" = 200 ] && echo ✅ || echo ❌)"
    if [ "$PROB" = 0 ]; then
      echo "✅ KEY_STATUS: OK — cheia poate publica complet (PR + merge + deploy). Niciun secret afișat, niciun deploy declanșat."
    else
      echo "❌ KEY_STATUS: $PROB problemă(e). SUPORT PENTRU ADRIAN: $SUPORT"
    fi
    exit "$PROB"
    ;;
  api)
    # Citire GitHub „la liber", cu tokenul — înlocuiește complet browserul.
    p=${1:?cale API, ex: /pulls/106 sau /commits/master sau "/actions/runs?per_page=3"}
    gh_api "$API$p" | jq . 2>/dev/null || gh_api "$API$p"
    ;;
  *)
    echo "folosire: kelion-github pr|merge|publish|deploy|rollback|doctor|runs|api (vezi comentariile din script)"
    exit 1
    ;;
esac
