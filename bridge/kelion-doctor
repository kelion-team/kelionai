#!/bin/bash
# KELION-DOCTOR — verificarea de sănătate a TUTUROR dependențelor fragile ale lui
# Kelion, ca să prindă DIN TIMP orice „blocaj din cauza unui X" și fie să-l repare
# ce poate, fie să-i dea lui Adrian SUPORTUL exact (Adrian, 14 iul: „dă-i ce
# trebuie ca să le poată el repara… ca problema să nu se mai repete și să fie
# capabil să ducă sarcinile la sfârșit"). Generalizează `kelion-github doctor`.
#
#   kelion-doctor           → raport uman complet
#   kelion-doctor --brief   → o linie mașină (DOCTOR_OK / DOCTOR_PROBLEM: <suport>)
#                             + exit code = numărul de probleme (0 = sănătos)
#
# NU expune valori de secrete. NU declanșează deploy. NU schimbă credențiale
# (un token/cheie NU poate fi generat de un AI — login+2FA; Kelion detectează +
# ghidează). Fiecare problemă vine cu pașii EXACȚI de reparare pentru Adrian.
set -u
ROOT=/root/kelion
B=https://kelionai.app
BRIEF=""; [ "${1:-}" = "--brief" ] && BRIEF=1
PROB=0; SUP=""
addp() { PROB=$((PROB + 1)); SUP="${SUP}($PROB) $1  "; }   # problemă reală → brief + alertă
line() { [ -z "$BRIEF" ] && echo "$1"; }                   # raport uman
warn() { [ -z "$BRIEF" ] && echo "$1"; }                   # informativ, NU alertă (fără false alarme)

SECRET=$(cat "$ROOT/bridge-secret.txt" 2>/dev/null || true)

line "== KELION-DOCTOR — sănătatea dependențelor =="

# 1. Aplicația e live?
V=$(curl -sS --max-time 8 -o /dev/null -w '%{http_code}' "$B/api/version" 2>/dev/null || echo 000)
if [ "$V" = 200 ]; then line "  App live (/api/version): 200 ✅"
else line "  App live: HTTP $V ❌"; addp "Aplicația nu răspunde la $B/api/version (HTTP $V). Verifică gazda (serviciile de pe VPS / containerul aplicației)."; fi

# 2. Serviciile systemd active?
if command -v systemctl >/dev/null 2>&1; then
  for s in kelion-bridge kelion-builder; do
    st=$(systemctl is-active "$s" 2>/dev/null || echo unknown)
    if [ "$st" = active ]; then line "  Serviciu $s: active ✅"
    else line "  Serviciu $s: $st ❌"; addp "Serviciul $s nu e activ ($st). Rulează workflow-ul vps-restart (sau pe VPS: systemctl restart $s)."; fi
  done
fi

# 3. Secretul punții — se potrivește cu backendul? (cauza «bec verde, bandă moartă»)
if [ -n "$SECRET" ]; then
  ac=$(curl -sS --max-time 10 -o /dev/null -w '%{http_code}' -H "x-bridge-secret: $SECRET" "$B/api/bridge/approved-releases" 2>/dev/null || echo 000)
  if [ "$ac" = 200 ]; then line "  Secret punte (auth backend): 200 ✅"
  elif [ "$ac" = 401 ]; then line "  Secret punte: 401 ❌"; addp "Secretul punții de pe VPS ($ROOT/bridge-secret.txt) NU se potrivește cu BRIDGE_SECRET din env-ul backendului (401). Pune aceeași valoare în ambele locuri."
  else line "  Secret punte: HTTP $ac (neconcludent)"; fi
else
  line "  Secret punte: LIPSĂ ❌"; addp "Lipsește $ROOT/bridge-secret.txt pe VPS — puntea nu se poate autentifica."
fi

# 4. Cheia GitHub — deleg la kelion-github doctor (aceeași diagnoză)
GH="$ROOT/repo/bridge/kelion-github"
if [ -f "$GH" ]; then
  gout=$(bash "$GH" doctor --brief 2>/dev/null); grc=$?
  if [ "$grc" = 0 ]; then line "  Cheie GitHub (publicare): OK ✅"
  else line "  Cheie GitHub: PROBLEMĂ ❌"; addp "GitHub — ${gout#KEY_PROBLEM: }"; fi
else
  line "  Cheie GitHub: nu găsesc $GH"
fi

# 5. Cheile creierului Kimi/GLM. Lipsă fișier = problemă sigură (munca moare fără
#    cheie). Ping-ul live e INFORMATIV aici (fără alarmă automată pe coduri
#    ambigue — cota reală se citește autoritar cu workflow-ul vps-diag).
check_brain() { # nume fișier url model
  local name="$1" f="$2" url="$3" model="$4" k c
  k=$(cat "$f" 2>/dev/null || true)
  if [ -z "$k" ]; then line "  $name: cheie LIPSĂ ❌"; addp "Lipsește cheia $name ($f) pe VPS — pune-o prin vps-keys ($name empty = munca cade pe rezervă/inert)."; return; fi
  c=$(curl -sS --max-time 12 -o /dev/null -w '%{http_code}' -X POST "$url" \
        -H "Authorization: Bearer $k" -H "content-type: application/json" \
        -d "{\"model\":\"$model\",\"max_tokens\":1,\"messages\":[{\"role\":\"user\",\"content\":\"ping\"}]}" 2>/dev/null || echo 000)
  case "$c" in
    200) line "  $name: cheie prezentă, ping 200 ✅" ;;
    429) warn "  $name: 429 — posibil cotă atinsă ⚠️ (verifică cu vps-diag; reîncarcă planul $name dacă e golit)" ;;
    401|403) warn "  $name: $c — posibil cheie invalidă ⚠️ (confirmă cu vps-diag înainte de a o reînnoi)" ;;
    *) line "  $name: cheie prezentă (ping HTTP $c, informativ)" ;;
  esac
}
check_brain "Kimi" "$ROOT/kimi-key.txt" "https://api.kimi.com/coding/v1/messages" "kimi-for-coding"
check_brain "GLM"  "$ROOT/glm-key.txt"  "https://api.z.ai/api/anthropic/v1/messages" "glm-4.6"

# 6. Integritate cod: procesul RULAT (systemd ExecStart) == fișierul din repo?
#    (lecția „cod rulat ≠ cod din repo" — fixuri pe disc dar procesul vechi în RAM)
if command -v systemctl >/dev/null 2>&1 && command -v md5sum >/dev/null 2>&1; then
  check_code() { # svc fisier-repo-relativ
    local svc="$1" rf="$ROOT/repo/$2" run
    run=$(systemctl show "$svc" -p ExecStart 2>/dev/null | grep -oE '/[^ "]+\.mjs' | head -1)
    [ -n "$run" ] && [ -f "$run" ] && [ -f "$rf" ] || return
    if [ "$(md5sum <"$run" | cut -d' ' -f1)" = "$(md5sum <"$rf" | cut -d' ' -f1)" ]; then line "  Cod $svc == repo ✅"
    else line "  Cod $svc ≠ repo ❌"; addp "Serviciul $svc rulează cod DIFERIT de repo ($run ≠ $rf). Rulează vps-restart/bridge-deploy ca să-l aliniezi + restart."; fi
  }
  check_code kelion-bridge  bridge/kelion-bridge-linux.mjs
  check_code kelion-builder bridge/kelion-builder-server.mjs
fi

# Verdict
if [ -n "$BRIEF" ]; then
  if [ "$PROB" = 0 ]; then echo "DOCTOR_OK"; else echo "DOCTOR_PROBLEM: $SUP"; fi
  exit "$PROB"
fi
echo "── Verdict ──"
if [ "$PROB" = 0 ]; then echo "✅ TOTUL SĂNĂTOS — Kelion poate duce sarcinile la capăt."
else echo "❌ $PROB problemă(e) de reparat. SUPORT PENTRU ADRIAN: $SUP"; fi
exit "$PROB"
