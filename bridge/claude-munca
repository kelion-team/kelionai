#!/bin/bash
# LANSATORUL DE MUNCĂ (ordinul lui Adrian, 11 iul): ORICE agent de lucru al lui
# Kelion (cercetător, navigator, constructor ad-hoc, orice spawn de claude
# pentru MUNCĂ) pornește prin scriptul ăsta, nu direct prin `claude`:
#
#   /root/kelion/repo/bridge/claude-munca -p "sarcina" --allowedTools ...
#
# Ce garantează:
#  1. BANII: munca merge pe Kimi (primar) sau GLM (rezervă) — NICIODATĂ pe
#     abonamentul Claude Max (ăla e doar pentru chatul lui Adrian + demo).
#     Autentificarea pe abonament e scoasă din env ca să nu poată fi ocolită.
#  2. PERFORMANȚA: modelul implicit e kimi-for-coding (cel mai puternic agentic
#     din lanțul de muncă); apelantul poate da alt --model dacă are motiv.
#  3. CUNOAȘTEREA: rulează din /root/kelion/repo → CLAUDE.md se încarcă automat
#     și trimite la AI-HANDOFF.md (ținut proaspăt de timer-ul repo-sync la 5
#     minute) — agentul are ACEEAȘI sursă de adevăr ca Claude și ca Kelion.
#
# Treapta golită: dacă cineva (builder, agent) atinge fișierul
# /root/kelion/kimi-down, Kimi e ocolit 30 de minute (se folosește GLM).
set -u

KIMI_KEY=$(cat /root/kelion/kimi-key.txt 2>/dev/null || true)
GLM_KEY=$(cat /root/kelion/glm-key.txt 2>/dev/null || true)

kimi_cooling() {
  local f=/root/kelion/kimi-down
  [ -f "$f" ] || return 1
  local age=$(( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) ))
  [ "$age" -lt 1800 ]
}

cd /root/kelion/repo 2>/dev/null || cd /root/kelion

if [ -n "$KIMI_KEY" ] && ! kimi_cooling; then
  # Model implicit doar dacă apelantul nu a dat unul.
  case " $* " in
    *" --model "*) : ;;
    *) set -- --model kimi-for-coding "$@" ;;
  esac
  exec env -u CLAUDE_CODE_OAUTH_TOKEN \
    ANTHROPIC_BASE_URL="https://api.kimi.com/coding/" \
    ANTHROPIC_API_KEY="$KIMI_KEY" \
    ANTHROPIC_AUTH_TOKEN="$KIMI_KEY" \
    CLAUDE_CODE_AUTO_COMPACT_WINDOW=262144 \
    claude "$@"
fi

if [ -n "$GLM_KEY" ]; then
  exec env -u CLAUDE_CODE_OAUTH_TOKEN \
    ANTHROPIC_BASE_URL="https://api.z.ai/api/anthropic" \
    ANTHROPIC_API_KEY="$GLM_KEY" \
    ANTHROPIC_AUTH_TOKEN="$GLM_KEY" \
    claude "$@"
fi

# ANTHROPIC/MAX SCOS COMPLET (Adrian, 12 iul: „renunț la Anthropic, rămâne Kimi
# și GLM"): fără cheie de muncă pe disc NU mai cădem pe Max — ieșim cu eroare, ca
# să nu atingem niciodată Anthropic. Cu cheile puse, aici nu se ajunge.
echo "[claude-munca] OPRIT: nicio cheie Kimi/GLM pe disc — Anthropic e scos, nu pornesc pe Max. Pune cheile prin vps-keys." >&2
exit 1
