[Unit]
Description=Kelionai — pool elastic de reparatori (scale-to-zero)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/kelion/repo
Environment=KELION_REPO=/root/kelion/repo
Environment=WT_BASE=/root/kelion/wt
Environment=MAX_REPAIRERS=3
Environment=POLL_MS=8000
EnvironmentFile=-/root/kelion/claude.env
ExecStart=/usr/bin/node /root/kelion/repo/bridge/kelion-repairer-pool.mjs
Restart=always
RestartSec=2
StartLimitIntervalSec=0
User=root

[Install]
WantedBy=multi-user.target
