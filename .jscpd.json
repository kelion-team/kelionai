{
  "path": ["backend/src", "frontend/src"],
  "minTokens": 50,
  "minLines": 5,
  "format": ["typescript", "tsx", "javascript", "jsx", "css"],
  "ignore": ["**/*.test.ts", "**/*.test.tsx", "**/dist/**", "**/node_modules/**"],
  "reporters": ["console", "json"],
  "output": "./.jscpd",
  "gitignore": true,
  "absolute": false
}
