{
  "path": ["backend/src", "frontend/src", "scripts"],
  "minTokens": 60,
  "minLines": 8,
  "format": ["typescript", "tsx", "javascript", "jsx", "css"],
  "ignore": ["**/*.test.*", "**/*.spec.*", "**/dist/**", "**/node_modules/**"],
  "reporters": ["console", "json"],
  "output": "./.jscpd",
  "gitignore": true,
  "absolute": false
}
