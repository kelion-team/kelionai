{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kelionai",
  "version": "1.1.1",
  "identifier": "app.kelionai.desktop",
  "build": {
    "frontendDist": "https://kelionai.app/"
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://kelionai.app/dl/desktop-update.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1MjA0NkQyQ0U1MDA2NEYKUldSUEJsRE8wa1lnNVFOTWlvRGhncWZvSmpTRWxKWGhjbk9ucnRJSGlJbDNteTRXVDVQdFh3M0oK"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Kelionai",
        "url": "https://kelionai.app/",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "AE Studio",
    "copyright": "© 2026 AE Studio",
    "category": "Productivity",
    "shortDescription": "Your brilliant AI assistant — it sees, hears and speaks.",
    "longDescription": "Kelionai is a brilliant personal AI assistant that sees, hears and speaks with you in dozens of languages.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Romanian"]
      }
    }
  }
}
