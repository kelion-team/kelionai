[Unit]
Description=Poll build_jobs with Kelion Constructor OpenCode + Qwen local (llama.cpp)
After=kelion-runtime-config-recovery.service
ConditionPathExists=/run/kelion/runtime-config-recovery.ready
ConditionPathExists=!/run/kelion/constructor-activation.pending

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=5s
RandomizedDelaySec=10s
Persistent=true
Unit=kelion-codex-worker.service

[Install]
WantedBy=timers.target
