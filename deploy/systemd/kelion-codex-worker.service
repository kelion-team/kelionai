[Unit]
Description=Kelion Constructor queue with local OpenCode/Qwen full-host executor
After=network-online.target private-ai-llm.service kelion-constructor-sync.service kelion-runtime-config-recovery.service
Wants=network-online.target
Requires=private-ai-llm.service kelion-constructor-sync.service
ConditionPathExists=/etc/kelion/codex-worker.enabled
ConditionPathExists=/run/kelion/runtime-config-recovery.ready
ConditionPathExists=!/run/kelion/constructor-activation.pending

[Service]
Type=oneshot
User=kelion-codex
Group=kelion-codex
SupplementaryGroups=kelion-handoff privateai
UMask=0027
WorkingDirectory=/var/lib/kelion-codex
Environment=PATH=/opt/private-ai/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=OPENCODE_BIN=/opt/private-ai/bin/opencode
Environment=OPENCODE_CONFIG_HOME=/srv/private-ai/home/.config
Environment=OPENCODE_CONFIG=/srv/private-ai/home/.config/opencode/opencode.json
Environment=OPENCODE_MODEL=llama.cpp/qwen3.6-35b-a3b-local
Environment=OPENCODE_BASE_URL=http://127.0.0.1:24080/v1
Environment=CODEX_WORKER_REPO=/var/lib/kelion-codex/repo
Environment=CODEX_WORKER_JOBS=/var/lib/kelion-codex/jobs
Environment=CODEX_HANDOFF_READY=/var/lib/kelion-constructor-handoff/ready
EnvironmentFile=/root/kelion/config/codex-worker.env
LoadCredential=codex-worker-secret:/root/kelion/secrets/codex-worker-secret
ExecStartPre=/usr/bin/node /opt/kelion-codex/codex-worker.mjs --self-test
ExecStart=/usr/bin/node /opt/kelion-codex/codex-worker.mjs --once
NoNewPrivileges=false
KeyringMode=shared
PrivateIPC=false
PrivateDevices=false
PrivateTmp=false
RuntimeDirectory=kelion-codex
RuntimeDirectoryMode=0700
ProtectProc=default
ProcSubset=all
ProtectClock=false
ProtectControlGroups=false
ProtectHome=false
ProtectHostname=false
ProtectKernelLogs=false
ProtectKernelModules=false
ProtectKernelTunables=false
ProtectSystem=false
ReadWritePaths=
RestrictAddressFamilies=
RestrictNamespaces=false
RestrictRealtime=false
RestrictSUIDSGID=false
LockPersonality=false
CapabilityBoundingSet=~
AmbientCapabilities=
SystemCallArchitectures=
MemoryMax=6G
TasksMax=512
TimeoutStartSec=100min
KillMode=control-group
