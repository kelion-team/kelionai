[Unit]
Description=Kelion Constructor isolated GitHub publisher
After=network-online.target kelion-runtime-config-recovery.service
Wants=network-online.target
ConditionPathExists=/etc/kelion/constructor-publisher.enabled
ConditionPathExists=/run/kelion/runtime-config-recovery.ready
ConditionPathExists=!/run/kelion/constructor-activation.pending
ConditionPathExists=!/root/kelion/runtime/constructor-reactivation.journal

[Service]
Type=oneshot
User=kelion-publisher
Group=kelion-publisher
SupplementaryGroups=kelion-handoff
UMask=0027
WorkingDirectory=/var/lib/kelion-publisher
Environment=PATH=/usr/bin:/bin
Environment=CONSTRUCTOR_PUBLISHER_REPO=/var/lib/kelion-publisher/repo
Environment=CONSTRUCTOR_PUBLISHER_STATE=/var/lib/kelion-publisher/state
Environment=CODEX_HANDOFF_READY=/var/lib/kelion-constructor-handoff/ready
Environment=CONSTRUCTOR_GITHUB_ASKPASS=/opt/kelion-constructor/github-askpass.sh
EnvironmentFile=/root/kelion/config/constructor-publisher.env
LoadCredential=constructor-publisher-secret:/root/kelion/secrets/constructor-publisher-secret
LoadCredential=github-publisher-token:/root/kelion/publisher-secrets/github-publisher-token
LoadCredential=github-publisher-signing-key:/root/kelion/publisher-secrets/github-publisher-signing-key
ExecStartPre=/usr/bin/node /opt/kelion-constructor/constructor-publisher.mjs --self-test
ExecStart=/usr/bin/node /opt/kelion-constructor/constructor-publisher.mjs --once
# The rootless gate runtime needs namespace/setuid helpers in this non-root
# supervisor. Gates retain no-new-privileges, no network and code-only mounts.
NoNewPrivileges=false
KeyringMode=shared
PrivateIPC=false
PrivateDevices=false
PrivateTmp=false
RuntimeDirectory=kelion-publisher
RuntimeDirectoryMode=0700
ProtectProc=default
ProcSubset=all
ProtectClock=false
ProtectControlGroups=false
ProtectHome=true
ProtectHostname=false
ProtectKernelLogs=false
ProtectKernelModules=false
ProtectKernelTunables=false
ProtectSystem=strict
ReadWritePaths=/var/lib/kelion-publisher/repo /var/lib/kelion-publisher/state /var/lib/kelion-publisher/.cache /var/lib/kelion-publisher/.config /var/lib/kelion-publisher/.local /var/lib/kelion-constructor-handoff /run/kelion-publisher
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=false
RestrictRealtime=false
RestrictSUIDSGID=false
LockPersonality=false
CapabilityBoundingSet=~
AmbientCapabilities=
SystemCallArchitectures=native
CPUQuota=200%
MemoryMax=6G
TasksMax=512
TimeoutStartSec=120min
KillMode=control-group
