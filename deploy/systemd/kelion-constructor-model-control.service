[Unit]
Description=Kelion Constructor approved-provider readiness controller
After=local-fs.target network-online.target
Wants=network-online.target
ConditionPathExists=/run/kelion/runtime-config-recovery.ready
ConditionPathExists=!/run/kelion/constructor-activation.pending
ConditionPathExists=!/root/kelion/runtime/constructor-deploy-quiesce.journal
ConditionPathExists=!/root/kelion/runtime/constructor-upgrade.journal
ConditionPathExists=!/root/kelion/runtime/constructor-max-model.journal
ConditionPathExists=!/root/kelion/runtime/runtime-config-cutover.journal
ConditionPathExists=!/root/kelion/runtime/constructor-activation.journal
ConditionPathExists=!/root/kelion/runtime/constructor-gate-refresh.journal
ConditionPathExists=!/root/kelion/runtime/destructive-cutover-recovery.json
ConditionPathExists=!/root/kelion/runtime/constructor-unit-migration.pending

[Service]
Type=simple
User=root
Group=10050
UMask=0007
WorkingDirectory=/
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LoadCredential=constructor-model-control-secret:/root/kelion/secrets/constructor-model-control-secret
ExecStartPre=/opt/private-ai/bin/constructor-model-switch --prepare-lock
ExecStartPre=/usr/bin/node /opt/kelion-constructor/constructor-model-control.mjs --self-test
ExecStart=/usr/bin/node /opt/kelion-constructor/constructor-model-control.mjs
Restart=on-failure
RestartSec=3s
RuntimeDirectory=kelion-constructor-model-control
RuntimeDirectoryMode=0750
# Keep the bind-mounted runtime directory inode stable across controller
# restarts so the live app never retains a stale control-socket mount.
RuntimeDirectoryPreserve=yes
BindReadOnlyPaths=/root/kelion/runtime:/run/kelion-constructor-model-control/deploy-journals
BindReadOnlyPaths=/root/kelion/publicare.lock:/run/kelion-constructor-model-control/publicare.lock
NoNewPrivileges=true
PrivateDevices=true
PrivateIPC=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=default
ProcSubset=all
ProtectSystem=strict
ReadWritePaths=/run/lock
# The controller makes only the fixed anonymous HTTPS catalog request over IPv4.
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
TasksMax=96
MemoryMax=256M
TimeoutStopSec=30s
KillMode=control-group

[Install]
WantedBy=multi-user.target
