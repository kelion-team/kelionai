[Unit]
Description=Synchronize the private Constructor source before local OpenCode execution
After=network-online.target kelion-runtime-config-recovery.service
Wants=network-online.target
ConditionPathExists=/run/kelion/runtime-config-recovery.ready
ConditionPathExists=!/run/kelion/constructor-activation.pending
ConditionPathExists=!/root/kelion/runtime/constructor-reactivation.journal

[Service]
Type=oneshot
User=kelion-codex
Group=kelion-codex
UMask=0077
Environment=PATH=/usr/bin:/bin
EnvironmentFile=/root/kelion/config/codex-worker.env
LoadCredential=github-worker-token:/root/kelion/worker-secrets/github-worker-token
ExecStart=/opt/kelion-constructor/constructor-sync-worker.sh
NoNewPrivileges=true
PrivateIPC=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/opt/kelion-constructor
ReadWritePaths=/var/lib/kelion-codex/repo
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
TimeoutStartSec=5min
