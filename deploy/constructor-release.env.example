# Config non-secret dedicat dispatcherului. El nu are SSH/VPS și nu execută
# deploy; poate doar porni deploy.yml pentru un commit master deja verificat.
CONSTRUCTOR_RELEASE_EXEC_ENABLED=0
KELION_CONSTRUCTOR_API=http://127.0.0.1:18079
KELION_GITHUB_REPOSITORY=owner/repository
KELION_PUBLIC_APP_ORIGIN=https://example.invalid
CONSTRUCTOR_RELEASE_WORKFLOW=deploy.yml
CONSTRUCTOR_RELEASE_REQUIRED_CHECKS=verify,container-isolation
