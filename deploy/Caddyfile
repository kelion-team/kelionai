{$PUBLIC_APP_DOMAIN} {
	encode zstd gzip

	# Access logging stays disabled because request logs are not an analytics store.
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		X-Permitted-Cross-Domain-Policies "none"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		Cross-Origin-Resource-Policy "same-site"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(self), payment=(self), browsing-topics=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-YL6PctrGP2DPZgUWOG7ka1HXOS8epjETovXPq2W+jBA='; script-src-attr 'none'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' blob: wss://{$PUBLIC_APP_DOMAIN} https://huggingface.co https://*.hf.co https://raw.githubusercontent.com; frame-src https://www.youtube.com https://youtube.com https://www.openstreetmap.org https://embed.waze.com https://embed.windy.com https://www.tradingview.com; manifest-src 'self'; upgrade-insecure-requests"
	}

	@apple_association path /.well-known/apple-app-site-association
	header @apple_association Content-Type application/json

	# Only the TCP peer, not a client-supplied forwarding header, establishes
	# whether the coarse Cloudflare country may be passed to the application.
	@cloudflare_peer remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	route {
		request_header -X-Kelion-Country
		request_header @cloudflare_peer X-Kelion-Country {http.request.header.CF-IPCountry}
		request_header -CF-IPCountry
		import /etc/caddy/upstream/kelion-upstream.caddy
	}
}

# Stable host-only control-plane address. Constructor services never need the
# public DNS path and cannot choose a release slot themselves.
http://:18079 {
	request_header -CF-Connecting-IP
	request_header -CF-IPCountry
	request_header -X-Kelion-Country
	import /etc/caddy/upstream/kelion-upstream.caddy
}
