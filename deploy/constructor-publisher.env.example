# Config non-secret dedicat publisherului. Ambele condiții de activare rămân 0/
# absente până când branch protection, GitHub App-ul minim și stagingul sunt
# verificate. Credentialele vin exclusiv prin systemd LoadCredential.
CONSTRUCTOR_PUBLISHER_EXEC_ENABLED=0
KELION_CONSTRUCTOR_API=http://127.0.0.1:18079
KELION_GITHUB_REPOSITORY=owner/repository
KELION_CODEX_GATE_IMAGE=ghcr.io/owner/repository/codex-gates@sha256:REPLACE_WITH_64_HEX_DIGEST
CONSTRUCTOR_REQUIRED_CHECKS=verify,container-isolation
CONSTRUCTOR_GIT_AUTHOR_NAME=Kelion Constructor Publisher
CONSTRUCTOR_GIT_AUTHOR_EMAIL=constructor-publisher@example.invalid
CONSTRUCTOR_GIT_SIGNING_FINGERPRINT=SHA256:REPLACE_WITH_43_BASE64_CHARACTERS
