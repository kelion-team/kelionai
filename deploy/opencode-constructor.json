{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "opencode-free/big-pickle",
  "small_model": "opencode-free/big-pickle",
  "enabled_providers": ["opencode-free"],
  "share": "disabled",
  "provider": {
    "opencode-free": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode — model gratuit aprobat",
      "options": {
        "baseURL": "https://opencode.ai/inference/openai/v1",
        "timeout": 120000,
        "chunkTimeout": 120000
      },
      "models": {
        "big-pickle": {
          "name": "Big Pickle",
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 4096
          }
        }
      }
    }
  },
  "permission": {
    "*": "deny",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "bash": "allow",
    "task": "allow",
    "skill": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny"
  },
  "instructions": ["instructions.md"],
  "server": {
    "hostname": "127.0.0.1",
    "port": 24096,
    "mdns": false
  }
}
