# ── Env aplicație Kelionai (VPS) — copiază în /root/kelion/kelionai.env ──────
# Legendă:  [AM] = deja primit în conversație (le pune Claude prin set-keys.sh)
#           [ADRIAN] = doar tu le ai (din vechiul setup Google/Railway/Stripe)
#           [AUTO] = se poate genera / valoare implicită

PORT=8080
NODE_ENV=production

# ── Creier + voce (le AM) ────────────────────────────────────────────────────
OPENROUTER_API_KEY=            # [AM] tot creierul (chat+work): GPT/Gemini/Claude
OPENAI_API_KEY=                # [AM] vocea OpenAI Realtime
OPENROUTER_CHAT_MODEL=openai/gpt-4.1-mini        # implicit chat (editabil)
OPENROUTER_WORK_MODEL=anthropic/claude-sonnet-5  # implicit creier (editabil)
OPENAI_REALTIME_MODEL=gpt-realtime
GITHUB_TOKEN=                  # [ADRIAN] fin-granulat, DOAR repo kelionai, Actions:write — mâinile lui Kelion pe runbook-uri (run_runbook)
OPENAI_REALTIME_VOICE=cedar    # o singură voce masculină

# ── Login Google (OBLIGATORII, doar tu le ai) ────────────────────────────────
GOOGLE_CLIENT_ID=              # [ADRIAN] Google Cloud Console → OAuth client
GOOGLE_CLIENT_SECRET=          # [ADRIAN]
GOOGLE_REDIRECT_URI=https://kelionai.app/auth/google/login/callback  # [ADRIAN] verifică calea reală
SESSION_SECRET=                # [AUTO] orice string lung aleator (ex: openssl rand -hex 32)

# ── Bază de date (OBLIGATORIU) ───────────────────────────────────────────────
# Postgres rulează pe VPS (127.0.0.1:5432). Ai nevoie de user/parolă/nume bază.
DATABASE_URL=postgres://USER:PAROLA@127.0.0.1:5432/kelion?sslmode=disable  # [ADRIAN]

# ── Plăți Stripe (le AM cheile; webhook-ul îl configurezi în Stripe) ─────────
STRIPE_SECRET_KEY=             # [AM] rk_live_... (restricted key)
STRIPE_WEBHOOK_SECRET=         # [ADRIAN] whsec_... din Stripe → Webhooks (endpoint /api/stripe/webhook)
STRIPE_CURRENCY=gbp
USER_SHARE=0.75                # 75% credite user / 25% fond admin
CREDIT_VALUE=0.1

# ── Skill-uri Google (opționale — degradează grațios dacă lipsesc) ───────────
GOOGLE_SERVICE_ACCOUNT_JSON=   # [ADRIAN] pentru TTS/skills (opțional)
GOOGLE_TTS_API_KEY=            # [ADRIAN] fallback STT/TTS (opțional)
GEMINI_API_KEY=               # [ADRIAN] corectură/embeddings (opțional)
SERPER_API_KEY=               # [ADRIAN] căutare web (opțional)
GOOGLE_MAPS_KEY=              # [ADRIAN] hărți (opțional)

# ── Mail contact@ (opțional) ─────────────────────────────────────────────────
MAIL_USER=contact@kelionai.app
MAIL_PASS=                    # [ADRIAN]
ADMIN_EMAIL=adrianenc11@gmail.com

# ── LiveKit (rulează pe VPS; cheile din setup-ul livekit) ────────────────────
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=              # [ADRIAN] din configul livekit de pe VPS
LIVEKIT_API_SECRET=           # [ADRIAN]

FRONTEND_ORIGIN=https://kelionai.app
