# Configurație non-secretă pentru containerul web. Secretele sunt fișiere
# individuale montate read-only; nu copia un inventar local de chei în acest env.
NODE_ENV=production
PORT=8080
PUBLIC_APP_ORIGIN=https://kelionai.app
FRONTEND_ORIGIN=https://kelionai.app
ADMIN_EMAIL=

# Cheia runtime este project-scoped și se află numai în openai-project-key.
OPENAI_API_KEY_FILE=/run/secrets/openai-project-key
OPENAI_LUNA_MODEL=
OPENAI_MEDIUM_MODEL=
OPENAI_HEAVY_MODEL=
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_TRANSCRIPTION_MODEL=
OPENAI_CALL_TRANSCRIPTION_MODEL=
OPENAI_TTS_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_VIDEO_MODEL=
OPENAI_VIDEO_PRICE_USD_MICROS_PER_SECOND=100000
OPENAI_VIDEO_SHUTDOWN_AT=2026-09-24T00:00:00.000Z

DATABASE_URL_FILE=/run/secrets/database-url
SESSION_SECRET_FILE=/run/secrets/session-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET_FILE=/run/secrets/google-client-secret
GOOGLE_TOKEN_ENCRYPTION_KEY_FILE=/run/secrets/google-token-encryption-key
GOOGLE_TOKEN_ENCRYPTION_KEY_ID=primary
GOOGLE_TOKEN_ENCRYPTION_PREVIOUS_KEY_FILE=
GOOGLE_TOKEN_ENCRYPTION_PREVIOUS_KEY_ID=
GOOGLE_REDIRECT_URI=https://kelionai.app/auth/google/callback

CODEX_WORKER_ENABLED=0
CODEX_WORKER_SECRET_FILE=/run/secrets/codex-worker-secret
CONSTRUCTOR_PUBLISHER_ENABLED=0
CONSTRUCTOR_PUBLISHER_SECRET_FILE=/run/secrets/constructor-publisher-secret
CONSTRUCTOR_RELEASE_ENABLED=0
CONSTRUCTOR_RELEASE_SECRET_FILE=/run/secrets/constructor-release-secret
BROWSER_WORKER_SOCKET=/run/kelion-browser-api/browser.sock
BROWSER_WORKER_SECRET_FILE=/run/secrets/browser-worker-secret
CONVERTER_WORKER_SOCKET=/run/kelion-converter-api/converter.sock
CONVERTER_WORKER_SECRET_FILE=/run/secrets/converter-worker-secret

VISITOR_CHAT_TTL_SECONDS=3600
VISITOR_ANALYTICS_RETENTION_DAYS=7
SESSION_ABSOLUTE_TTL_SECONDS=604800
SESSION_IDLE_TTL_SECONDS=86400
SESSION_TOUCH_INTERVAL_SECONDS=300
SESSION_MAX_ACTIVE_PER_ACCOUNT=5
SESSION_RECENT_REAUTH_SECONDS=600
NATIVE_AUTH_REQUEST_TTL_SECONDS=600
NATIVE_AUTH_EXCHANGE_TTL_SECONDS=120
NATIVE_CHANNEL_TICKET_TTL_SECONDS=30
OFFLINE_SYNC_MAX_TURNS=100
OFFLINE_SYNC_MAX_TEXT_CHARS=8000
OFFLINE_SYNC_MAX_AGE_DAYS=30
OFFLINE_SYNC_FUTURE_SKEW_SECONDS=300
VOCAL_LIVE_IDLE_TIMEOUT_SECONDS=600
PRIVACY_POLICY_UPDATED=2026-08-24
DATA_CONTROLLER_NAME=Configurează operatorul legal
PRIVACY_BACKUP_RETENTION_DAYS=30
FINANCIAL_RETENTION_YEARS=6
JOURNAL_RETENTION_DAYS=30
MEDIA_RETENTION_DAYS=30
CREDIT_PRICE_MINOR=10
CHAT_TURN_PRICE_MINOR=1
VOICE_LIVE_MINUTE_PRICE_MINOR=2
CALL_UTTERANCE_PRICE_MINOR=1
BILLING_FIRST_TOPUP_MIN_MINOR=2000
BILLING_TOPUP_STEP_MINOR=500
BILLING_TOPUP_MIN_MINOR=500
BILLING_TOPUP_MAX_MINOR=50000
LOW_CREDIT_THRESHOLD_MINOR=200
LOW_CREDIT_TOPUP_MINOR=1000

# Nicio creditare automată nu este permisă până la verificarea contractului și
# a webhookului semnat pentru modul ales.
PAYMENT_MODE=disabled
PAYMENT_CONTRACT_VERIFIED=false
REVOLUT_MERCHANT_API_VERSION=2026-04-20
REVOLUT_ORDER_EXPIRY=PT30M
REVOLUT_MERCHANT_SECRET_KEY_FILE=/run/secrets/revolut-merchant-secret-key
REVOLUT_WEBHOOK_SIGNING_SECRET_FILE=/run/secrets/revolut-webhook-signing-secret
PUSH_ENABLED=0
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_FILE=/run/secrets/vapid-private-key
PUSH_ENDPOINT_HOSTS=
PUSH_MAX_SUBSCRIPTIONS=5

# Capabilități opționale, inactive în lipsa propriului secret-file și readiness.
GOOGLE_TTS_ENABLED=false
GOOGLE_TTS_VOICE=Charon
SEARCH_ENABLED=false
MAIL_ENABLED=false
RELEASE_CANDIDATE_MODE=0
