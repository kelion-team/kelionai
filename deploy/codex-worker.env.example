# Config non-secret dedicat workerului Constructor. Nu folosi host.env sau
# kelionai.env: ar injecta secretele aplicației în procesul supervisor.
CODEX_WORKER_EXEC_ENABLED=0
KELION_CODEX_API=http://127.0.0.1:18079
KELION_GITHUB_REPOSITORY=owner/repository
KELION_CODEX_GATE_IMAGE=ghcr.io/owner/repository/codex-gates@sha256:REPLACE_WITH_64_HEX_DIGEST
