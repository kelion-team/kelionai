# Access gate (v1 = only this account allowed). Comma-separated.
ALLOWLIST=adrianenc11@gmail.com
ADMIN_EMAIL=adrianenc11@gmail.com

# Where the built frontend lives (served in production)
FRONTEND_DIST=../frontend/dist

# Frontend origin for local dev redirects
FRONTEND_ORIGIN=http://localhost:5173
