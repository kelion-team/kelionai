# Exemplu local fără credențiale. Copiază-l în .env și completează numai
# serviciile folosite; producția folosește config/runtime.env + secret files.
NODE_ENV=development
PORT=8080
BIND_HOST=127.0.0.1
PUBLIC_APP_ORIGIN=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_EMAIL=owner@example.com

# OpenAI runtime: numai o cheie project-scoped; cheia organization-admin nu
# aparține aplicației, workerului Codex sau acestui fișier.
OPENAI_API_KEY=
OPENAI_LUNA_MODEL=
OPENAI_MEDIUM_MODEL=
OPENAI_HEAVY_MODEL=
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_TRANSCRIPTION_MODEL=
# Comma-separated deployment allow-list. Both selected realtime models above
# must appear here in production; set exact account-approved model IDs only.
OPENAI_APPROVED_REALTIME_MODELS=
OPENAI_CALL_TRANSCRIPTION_MODEL=
OPENAI_TTS_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_VIDEO_MODEL=
OPENAI_VIDEO_PRICE_USD_MICROS_PER_SECOND=100000
OPENAI_VIDEO_SHUTDOWN_AT=2026-09-24T00:00:00.000Z
VIDEO_ALLOW_PAID=0

DATABASE_URL=
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_TOKEN_ENCRYPTION_KEY_ID=primary
GOOGLE_TOKEN_ENCRYPTION_PREVIOUS_KEY=
GOOGLE_TOKEN_ENCRYPTION_PREVIOUS_KEY_ID=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

SESSION_ABSOLUTE_TTL_SECONDS=604800
SESSION_IDLE_TTL_SECONDS=86400
SESSION_TOUCH_INTERVAL_SECONDS=300
SESSION_MAX_ACTIVE_PER_ACCOUNT=5
SESSION_RECENT_REAUTH_SECONDS=600
NATIVE_AUTH_REQUEST_TTL_SECONDS=600
NATIVE_AUTH_EXCHANGE_TTL_SECONDS=120
NATIVE_CHANNEL_TICKET_TTL_SECONDS=30
OFFLINE_SYNC_MAX_TURNS=100
OFFLINE_SYNC_MAX_TEXT_CHARS=8000
OFFLINE_SYNC_MAX_AGE_DAYS=30
OFFLINE_SYNC_FUTURE_SKEW_SECONDS=300
VOCAL_LIVE_IDLE_TIMEOUT_SECONDS=600

VISITOR_CHAT_TTL_SECONDS=3600
VISITOR_ANALYTICS_RETENTION_DAYS=7
PRIVACY_POLICY_UPDATED=2026-08-24
DATA_CONTROLLER_NAME=Example Operator
PRIVACY_BACKUP_RETENTION_DAYS=30
FINANCIAL_RETENTION_YEARS=6
JOURNAL_RETENTION_DAYS=30
MEDIA_RETENTION_DAYS=30

CREDIT_PRICE_MINOR=10
CHAT_TURN_PRICE_MINOR=1
VOICE_LIVE_MINUTE_PRICE_MINOR=2
CALL_UTTERANCE_PRICE_MINOR=1
BILLING_FIRST_TOPUP_MIN_MINOR=2000
BILLING_TOPUP_STEP_MINOR=500
BILLING_TOPUP_MIN_MINOR=500
BILLING_TOPUP_MAX_MINOR=50000
LOW_CREDIT_THRESHOLD_MINOR=200
LOW_CREDIT_TOPUP_MINOR=1000
PAYMENT_MODE=disabled
PAYMENT_CONTRACT_VERIFIED=false
REVOLUT_MERCHANT_API_VERSION=2026-04-20
REVOLUT_ORDER_EXPIRY=PT30M
REVOLUT_MERCHANT_SECRET_KEY=
REVOLUT_WEBHOOK_SIGNING_SECRET=
PUSH_ENABLED=0
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_ENDPOINT_HOSTS=
