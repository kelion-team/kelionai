# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=8080

# Google OAuth (reused from backup — put the real secret here locally / in Railway env)
GOOGLE_CLIENT_ID=23728926513-nr22hvl687rjlr5cnsenc280l8lf7esb.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=PUT_THE_GOCSPX_SECRET_HERE
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# Session signing secret (any long random string locally)
SESSION_SECRET=dev-only-change-me-to-a-long-random-string

# Access gate (v1 = only this account allowed). Comma-separated.
ALLOWLIST=adrianenc11@gmail.com
ADMIN_EMAIL=adrianenc11@gmail.com

# Where the built frontend lives (served in production)
FRONTEND_DIST=../frontend/dist

# Frontend origin for local dev redirects
FRONTEND_ORIGIN=http://localhost:5173

# LiveKit self-hosted (auto-generated on VPS by bridge/kelion-livekit)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Model routing (optional — defaults shown; set in Railway to swap models instantly)
KELION_FAST_MODEL=claude-fable-5
KELION_TOP_MODEL=claude-opus-4-8
KELION_MEMORY_MODEL=claude-haiku-4-5-20251001
KELION_PING_MODEL=
# Worker/constructor models (VPS)
KELION_WORK_KIMI_MODEL=kimi-for-coding
KELION_WORK_GLM_MODEL=glm-4.6
KELION_VERIFIER_MODEL=
