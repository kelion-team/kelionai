# syntax=docker/dockerfile:1.7
ARG NODE_IMAGE=node:22-bookworm-slim@sha256:a17d50af28002a160548bd4225b3cfcb12c5efcb171f79e68758f2885fb1b066

FROM ${NODE_IMAGE} AS dependencies
WORKDIR /opt/kelion
COPY backend/package.json backend/package-lock.json ./backend/
RUN cd backend && npm ci --no-audit --no-fund
COPY frontend/package.json frontend/package-lock.json ./frontend/
RUN cd frontend && npm ci --no-audit --no-fund
COPY deploy/gates/package.json deploy/gates/package-lock.json ./gates/
RUN cd gates && npm ci --no-audit --no-fund

FROM ${NODE_IMAGE} AS gitleaks
ARG GITLEAKS_VERSION=8.30.1
ARG GITLEAKS_LINUX_X64_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location \
      --retry 3 --connect-timeout 20 --max-time 180 \
      "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" \
      --output /tmp/gitleaks.tar.gz \
    && printf '%s  %s\n' "$GITLEAKS_LINUX_X64_SHA256" /tmp/gitleaks.tar.gz | sha256sum --check --strict \
    && tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks \
    && chmod 0755 /usr/local/bin/gitleaks \
    && rm /tmp/gitleaks.tar.gz

FROM ${NODE_IMAGE} AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends bash git openssh-client python3 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/kelion/locks /work /var/lib/kelion-codex/repo/.git
COPY --from=dependencies /opt/kelion/backend/node_modules /opt/kelion/backend/node_modules
COPY --from=dependencies /opt/kelion/frontend/node_modules /opt/kelion/frontend/node_modules
COPY --from=dependencies /opt/kelion/gates/node_modules /opt/kelion/gates/node_modules
COPY backend/package.json /opt/kelion/locks/backend-package.json
COPY backend/package-lock.json /opt/kelion/locks/backend-package-lock.json
COPY frontend/package.json /opt/kelion/locks/frontend-package.json
COPY frontend/package-lock.json /opt/kelion/locks/frontend-package-lock.json
COPY --from=gitleaks /usr/local/bin/gitleaks /usr/local/bin/gitleaks
COPY --chmod=0555 deploy/gates/run-gates.sh /usr/local/bin/kelion-run-gates

USER node
ENTRYPOINT ["/usr/local/bin/kelion-run-gates"]
